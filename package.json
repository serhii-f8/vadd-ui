{
  "name": "vadd-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome check . && node scripts/check-forbidden-apis.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "node scripts/check-runtime-deps.mjs && node scripts/check-versions.mjs && node scripts/check-targets.mjs && node scripts/check-bundle-size.mjs",
    "gate": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
