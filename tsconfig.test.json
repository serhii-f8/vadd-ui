{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["packages/*/test/**/*", "skills/*/test/**/*", "scripts/**/*", "vitest.config.ts"],
  "exclude": ["scripts/test/fixtures/**"]
}
