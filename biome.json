{
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!**/dist",
      "!**/node_modules",
      "!scripts/test/fixtures",
      "!scripts/token-baseline.json",
      "!scripts/perf-baseline.json",
      "!scripts/perf-reference.vui.min.js",
      "!packages/ui-cli/corpus",
      "!e2e/harness/orca",
      "!.claude"
    ]
  }
}
