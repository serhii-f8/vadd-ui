{
  // The vendored Orca sources use extensionless imports and must stay byte for byte (VD-063).
  "extends": "../tsconfig.test.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    // Orca's own settings: `native-chat-visual-directive.ts` indexes a match and cannot change.
    "noUncheckedIndexedAccess": false,
    // The `<VuiView>` page (VD-143): React's types live with `ui-react`, its only user.
    "paths": {
      "react": ["../packages/ui-react/node_modules/@types/react"],
      "react-dom/client": ["../packages/ui-react/node_modules/@types/react-dom/client"]
    }
  },
  "include": ["**/*", "../playwright.config.ts"],
  "exclude": []
}
