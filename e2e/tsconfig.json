{
  // The vendored Orca sources use extensionless imports and must stay byte for byte (VD-063).
  "extends": "../tsconfig.test.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    // Orca's own settings: `native-chat-visual-directive.ts` indexes a match and cannot change.
    "noUncheckedIndexedAccess": false
  },
  "include": ["**/*", "../playwright.config.ts"],
  "exclude": []
}
